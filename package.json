{
  "name": "react-pts-canvas",
  "version": "0.5.2",
  "description": "A React canvas component for the Pts creative-coding library.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @react-pts-canvas/gallery dev",
    "build": "vite build && tsc --project tsconfig.lib.json && node scripts/create-cjs-declaration.mjs",
    "build:examples": "pnpm --filter @react-pts-canvas/gallery build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/check-packed-package.mjs",
    "lint": "oxlint --react-plugin --vitest-plugin --deny-warnings src test scripts vite.config.ts",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "preview": "pnpm --filter @react-pts-canvas/gallery preview",
    "check:package": "publint && attw --pack .",
    "check:library": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package && pnpm check:package",
    "check:examples": "pnpm format:check && pnpm --filter @react-pts-canvas/gallery check",
    "check": "pnpm check:library && pnpm check:examples",
    "prepublishOnly": "pnpm check:library",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "pts": "^0.12.9",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "oxlint": "1.78.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "pts": "0.12.9",
    "publint": "0.3.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "keywords": [
    "canvas",
    "creative-coding",
    "pts",
    "react",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamngan/react-pts-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/williamngan/react-pts-canvas/issues"
  },
  "homepage": "https://github.com/williamngan/react-pts-canvas#readme",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0"
}
